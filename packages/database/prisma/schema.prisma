generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  emailVerified   DateTime?
  image           String?
  keywords        String?   // Stored as JSON string '["Software Engineer"]'
  locations       String?   // Stored as JSON string '["Remote"]'
  notifyEmail     Boolean   @default(true)
  notifySms       Boolean   @default(false)
  name            String?
  githubUrl       String?
  linkedinUrl     String?
  resumeText      String?
  phoneNumber     String?  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  jobs            Job[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String   @id @default(cuid())
  title           String
  company         String
  location        String?
  url             String
  description     String?
  salary          String?
  source          String   // e.g. "LinkedIn", "Indeed"
  postedAt        DateTime?
  state           String   @default("NEW") // "NEW", "SAVED", "APPLIED", "INTERVIEWING", "OFFER", "REJECTED", "ARCHIVED"
  matchScore      Int?
  matchRationale  String?
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  notes           Note[]
  events          TimelineEvent[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, state])
  @@unique([userId, url])
  @@index([createdAt])
}

model Note {
  id        String   @id @default(cuid())
  text      String
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(cuid())
  type        String   // e.g., 'STATE_CHANGE', 'NOTE_ADDED', 'INTERVIEW_SCHEDULED'
  description String
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
